{
  "name": "coderelay",
  "version": "1.1.0",
  "private": true,
  "description": "Remote-control your own coding agents. Send a task from your phone; your home PC runs GitHub Copilot CLI or Claude Code against your local repo, runs your tests, and reports back. Telegram bot + installable web app, zero recurring cost.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tayebbb/CodeRelay.git"
  },
  "homepage": "https://github.com/Tayebbb/CodeRelay#readme",
  "bugs": "https://github.com/Tayebbb/CodeRelay/issues",
  "keywords": [
    "coding-agent",
    "github-copilot",
    "claude-code",
    "telegram-bot",
    "pwa",
    "self-hosted",
    "remote-development",
    "ai-agent",
    "developer-tools"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "remote-agent": "./bin/remote-agent.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node --no-warnings=ExperimentalWarning dist/src/main.js",
    "dev": "node --no-warnings=ExperimentalWarning --experimental-strip-types src/main.ts",
    "agent": "node --no-warnings=ExperimentalWarning bin/remote-agent.js",
    "doctor": "node --no-warnings=ExperimentalWarning bin/remote-agent.js doctor",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "tsc -p tsconfig.lint.json",
    "test": "npm run lint && npm run build && node --no-warnings=ExperimentalWarning --test-concurrency=1 --test \"dist/tests/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
